{
  "name": "@aether-winds/luminary",
  "version": "0.0.1",
  "description": "A lightweight, dependency-free web component library.",
  "type": "module",
  "contributors": [
    {
      "name": "Patrick Ortiz",
      "email": "pogithub@gmail.com"
    }
  ],
  "license": "See LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aether-winds/luminary.git"
  },
  "files": [
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/trusted-types": "2.0.7",
    "esbuild": "0.28.1",
    "jsdom": "^30.0.1",
    "nodemon": "3.1.14",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "./scripts/start-dev-server.sh",
    "test": "f() { node --experimental-test-coverage --import=tsx --import=./src/setup-dom-for-tests.ts --no-strip-types --test \"${1:-*/**/*.test.ts}\"; }; f",
    "test:watch": "f() { nodemon --watch \"*/**/*.ts\" --ext ts --exec \"clear && npm run test -- ${1}\"; }; f"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
